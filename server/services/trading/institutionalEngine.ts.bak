import { db } from "../../db";
import { tradingAccounts, capitalPartitions, paperTradingState, paperTradeOutcomes } from "@shared/schema";
import { normalizeTradingState } from "./state-normalizer";
import { desc, eq } from "drizzle-orm";

export interface AccountSummary {
  id: string;
  accountName: string;
  accountType: string;
  allocatedCapital: number;
  currentBalance: number;
  pnl: number;
  pnlPct: number;
  maxDrawdownPct: number;
  isActive: boolean;
  strategies: string[];
  symbols: string[];
  partitions: { name: string; allocated: number; used: number; reserved: number; available: number; purpose: string | null }[];
}

export async function getInstitutionalStatus(): Promise<{
  accounts: AccountSummary[];
  totalAUM: number;
  totalPnl: number;
  totalPnlPct: number;
  performanceSummary: {
    winRate: number;
    sharpeProxy: number;
    maxDrawdown: number;
    totalTrades: number;
  };
}> {
  const [accounts, partitions, tradingState, outcomes] = await Promise.all([
    db.select().from(tradingAccounts),
    db.select().from(capitalPartitions),
    db.select().from(paperTradingState).limit(1),
    db.select().from(paperTradeOutcomes).orderBy(desc(paperTradeOutcomes.createdAt)).limit(200),
  ]);

  const state = tradingState[0];

  const accountSummaries: AccountSummary[] = accounts.map(acct => {
    const acctPartitions = partitions.filter(p => p.accountId === acct.id);
    const currentBalance = state?.currentCapital || acct.currentBalance;
    const pnl = state?.totalPnl || acct.pnl;

    return {
      id: acct.id,
      accountName: acct.accountName,
      accountType: acct.accountType,
      allocatedCapital: acct.allocatedCapital,
      currentBalance,
      pnl: Math.round(pnl * 100) / 100,
      pnlPct: acct.allocatedCapital > 0 ? Math.round((pnl / acct.allocatedCapital) * 10000) / 100 : 0,
      maxDrawdownPct: acct.maxDrawdownPct,
      isActive: acct.isActive,
      strategies: (acct.strategiesJson as string[]) || [],
      symbols: (acct.symbolsJson as string[]) || [],
      partitions: acctPartitions.map(p => ({
        name: p.partitionName,
        allocated: p.allocatedAmount,
        used: p.usedAmount,
        reserved: p.reservedAmount,
        available: p.allocatedAmount - p.usedAmount - p.reservedAmount,
        purpose: p.purpose,
      })),
    };
  });

  const totalAUM = accountSummaries.reduce((s, a) => s + a.currentBalance, 0);
  const totalPnl = accountSummaries.reduce((s, a) => s + a.pnl, 0);
  const totalAllocated = accountSummaries.reduce((s, a) => s + a.allocatedCapital, 0);

  const wins = outcomes.filter(o => (o.realizedPnl || o.realizedPnl) > 0).length;
  const winRate = outcomes.length > 0 ? Math.round((wins / outcomes.length) * 100) : 0;

  const pnls = outcomes.map(o => o.realizedPnl || o.realizedPnl);
  const avgPnl = pnls.length > 0 ? pnls.reduce((s, v) => s + v, 0) / pnls.length : 0;
  const stdPnl = pnls.length > 1 ? Math.sqrt(pnls.reduce((s, v) => s + (v - avgPnl) ** 2, 0) / pnls.length) : 1;
  const sharpeProxy = stdPnl > 0 ? Math.round((avgPnl / stdPnl) * 100) / 100 : 0;

  const drawdown = state?.peakCapital && state?.currentCapital
    ? Math.round(((state.paperCapital - state.paperCapital) / state.paperCapital) * 10000) / 100
    : 0;

  return {
    accounts: accountSummaries,
    totalAUM: Math.round(totalAUM),
    totalPnl: Math.round(totalPnl * 100) / 100,
    totalPnlPct: totalAllocated > 0 ? Math.round((totalPnl / totalAllocated) * 10000) / 100 : 0,
    performanceSummary: {
      winRate, sharpeProxy, maxDrawdown: drawdown, totalTrades: outcomes.length,
    },
  };
}
